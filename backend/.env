# This app uses Ollama (https://ollama.com) — a free, local AI runtime.
# No API key or account needed. Install Ollama, then run:
#   ollama pull llama3.2:3b
#   ollama serve
# (ollama serve usually starts automatically after install on Mac/Windows)
#
# llama3.2:3b is small (~1.3GB) and fast on modest/CPU-only hardware.
# Want better extraction accuracy and have the RAM/GPU for it? Try:
#   ollama pull llama3.2        (3B, ~2GB, good balance)
#   ollama pull llama3.1        (8B, ~4.7GB, most accurate of the three)

OLLAMA_MODEL=llama3.2:3b
OLLAMA_HOST=http://localhost:11434

# MongoDB — install locally (https://www.mongodb.com/try/download/community)
# and run `mongod`, or use a free MongoDB Atlas cluster and paste its
# connection string here instead (starts with mongodb+srv://...).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=resume_parser
